# MedGraph Sentinel — environment template
# Copy to .env and fill in. NOTHING in .env is ever committed (see .gitignore).
# Full variable semantics: docs/INTERFACES.md §1.

# --- Neo4j (required) ---
# Choose a strong password; used by the neo4j container and all Python modules.
NEO4J_PASSWORD=change-me
NEO4J_USER=neo4j
# Inside docker compose the services use bolt://neo4j:7687 automatically;
# this value is for running modules directly on your host.
NEO4J_URI=bolt://localhost:7687

# --- Neo4j memory profile (pick ONE pair — docs/INTERFACES.md §1) ---
# 8 GB machine  -> HEAP 2G, PAGECACHE 1G   (the floor; must always work)
# 16 GB+ machine -> HEAP 4G, PAGECACHE 2G
# Check your RAM: PowerShell `wmic ComputerSystem get TotalPhysicalMemory`
NEO4J_HEAP_SIZE=2G
NEO4J_PAGECACHE_SIZE=1G

# --- Generator ---
# The committed dataset was produced with seed 42. Change only when
# deliberately producing a different world (regenerating for evaluation uses
# 42 + scenario overlays).
GENERATOR_SEED=42

# --- Narration ---
# Default: narration is pre-generated committed data (ADR-032) and no
# variable below is needed — leave them unset for the fully-offline demo.
# ADR-037 (branch next/prediction-gemini) adds an OPT-IN live tier:
# set both to enable; any live failure silently falls back to the cache.
#NARRATION_LIVE=true
#GEMINI_API_KEY=your-google-ai-studio-key   # free tier: aistudio.google.com
# Optional model override if the default in api/narration/live.py is renamed
# (default gemini-3.5-flash-lite — measured 0.9 s, fits the 5 s ceiling):
#GEMINI_MODEL=gemini-3.5-flash-lite

# --- Ports ---
API_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
